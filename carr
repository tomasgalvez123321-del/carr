<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CARRROS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --green: #1B4332;
    --green-dark: #10291F;
    --beige: #F2EBDA;
    --card: #FFFFFF;
    --ink: #201F1D;
    --ink-soft: #5B5650;
    --line: #E2D9C2;
    --gold: #C99A2E;
    --sold: #B4432E;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--beige);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    line-height: 1.5;
  }

  h1, h2, h3{
    font-family: 'Poppins', sans-serif;
    margin: 0;
  }

  header{
    background: var(--green);
    color: #fff;
    padding: 28px 24px 26px;
  }

  .header-inner{
    max-width: 1000px;
    margin: 0 auto;
  }

  .header-top{
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .logo-badge{
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background: #fff;
    color: var(--green);
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    padding: 8px 20px;
    border-radius: 999px;
  }

  #lang-toggle{
    background: transparent;
    border: 1px solid rgba(255,255,255,0.5);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 7px 14px;
    border-radius: 999px;
    cursor: pointer;
    flex-shrink: 0;
  }

  #lang-toggle:hover{
    border-color: #fff;
  }

  header p.tagline{
    margin-top: 16px;
    max-width: 46ch;
    color: #EDE6D2;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  /* ---------- AVISO DESTACADO ---------- */
  .notice{
    background: var(--gold);
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  .notice-inner{
    max-width: 1000px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .notice p, .notice span{
    margin: 0;
    color: #2A2205;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  /* ---------- NAV DE CATEGORÍAS ---------- */
  nav{
    position: sticky;
    top: 0;
    background: var(--beige);
    border-bottom: 1px solid var(--line);
    z-index: 10;
  }

  .nav-inner{
    max-width: 1000px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  nav button{
    font-family: 'Inter', sans-serif;
    text-decoration: none;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
  }

  nav button.active{
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }

  main{
    max-width: 1000px;
    margin: 0 auto;
    padding: 36px 24px 20px;
  }

  main h2{
    font-size: 1.5rem;
    font-weight: 700;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 8px;
    margin-bottom: 24px;
  }

  .grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 24px;
  }

  .item-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
  }

  /* ---------- VISTA DE DETALLE ---------- */
  .back-link{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: var(--green);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0;
    margin-bottom: 20px;
    cursor: pointer;
  }

  .detail-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    max-width: 560px;
  }

  .detail-image{
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #EDE8DC, #DCE4D8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    font-size: 0.95rem;
    position: relative;
    overflow: hidden;
  }

  .detail-image img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-row{
    display: flex;
    gap: 8px;
    padding: 12px 16px 0;
    flex-wrap: wrap;
  }

  .thumb-row img{
    width: 62px;
    height: 62px;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 2px solid transparent;
    opacity: 0.75;
  }

  .thumb-row img.active{
    border-color: var(--green);
    opacity: 1;
  }

  .detail-image .price-tag{
    top: 14px;
  }

  .detail-body{
    padding: 20px 22px 24px;
  }

  .detail-body h2.detail-name{
    font-size: 1.4rem;
    font-weight: 700;
    border: none;
    padding: 0;
    margin: 10px 0 14px;
  }

  .detail-badges{
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .detail-specs{
    list-style: none;
    margin: 0 0 18px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--ink-soft);
    display: grid;
    gap: 8px;
  }

  .detail-specs strong{
    color: var(--ink);
    font-weight: 600;
  }

  .detail-description{
    font-size: 0.96rem;
    color: var(--ink);
    line-height: 1.6;
    white-space: pre-line;
  }

  .item-image{
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #EDE8DC, #DCE4D8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    font-size: 0.85rem;
    overflow: hidden;
  }

  .item-image img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .financing-row{
    padding: 10px 16px 0;
  }

  .financing-badge{
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .financing-badge.yes{
    background: #E4EFE0;
    color: #2F6B27;
  }

  .financing-badge.no{
    background: #F5E2DD;
    color: var(--sold);
  }

  .price-tag{
    position: absolute;
    top: 12px;
    right: 0;
    background: var(--gold);
    color: #2A2205;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 5px 14px 5px 12px;
    border-radius: 3px 0 0 3px;
  }

  .item-info{
    padding: 14px 16px 16px;
  }

  .category-label{
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--green);
    margin-bottom: 4px;
  }

  .item-info h3{
    font-size: 1.08rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .specs{
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
    display: grid;
    gap: 4px;
  }

  .specs strong{
    color: var(--ink);
    font-weight: 600;
  }

  .status{
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .status.available{
    background: #E4EFE0;
    color: #2F6B27;
  }

  .status.sold{
    background: #F5E2DD;
    color: var(--sold);
  }

  .item-card[data-status="sold"] .item-image,
  .detail-card[data-status="sold"] .detail-image{
    filter: grayscale(60%);
    opacity: 0.7;
  }

  footer{
    background: var(--green-dark);
    color: #E9E4D8;
    margin-top: 40px;
    padding: 40px 24px;
  }

  .footer-inner{
    max-width: 1000px;
    margin: 0 auto;
  }

  footer h2{
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: 8px;
  }

  footer p{
    color: #C7CFC8;
    margin: 0 0 20px;
    max-width: 46ch;
  }

  .contact-links{
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .contact-links a{
    text-decoration: none;
    background: var(--gold);
    color: #2A2205;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .contact-links a.secondary{
    background: transparent;
    color: #fff;
    border: 1px solid #3E5C57;
    font-weight: 500;
  }

  .location{
    font-size: 0.9rem;
    color: #A9B6AC;
  }

  @media (max-width: 480px){
    header{ padding: 22px 20px 22px; }
    main{ padding: 30px 20px 10px; }
  }
</style>
</head>
<body>

  <header>
    <div class="header-inner">
      <div class="header-top">
        <span class="logo-badge">CARR🛞S</span>
        <button id="lang-toggle" onclick="toggleLang()">ENGLISH</button>
      </div>
      <p class="tagline" id="tagline"></p>
    </div>
  </header>

  <div class="notice">
    <div class="notice-inner">
      <span id="notice-text"></span>
    </div>
  </div>

  <nav>
    <div class="nav-inner" id="category-nav"></div>
  </nav>

  <main>
    <div id="grid-view">
      <h2 id="section-title"></h2>
      <div class="grid" id="item-grid"></div>
    </div>
    <div id="detail-view" style="display:none;">
      <button class="back-link" onclick="closeDetail()" id="back-link"></button>
      <div class="detail-card" id="detail-card"></div>
    </div>
  </main>

  <footer>
    <div class="footer-inner">
      <h2 id="contact-heading"></h2>
      <p id="contact-sub"></p>
      <div class="contact-links">
        <a href="tel:+15551234567" id="call-link"></a>
        <a class="secondary" href="sms:+15551234567" id="text-link"></a>
      </div>
      <p class="location">📍 Richmond</p>
    </div>
  </footer>

<script>
  const t = {
    es: {
      tagline: "Autos, joyería de oro, relojes y más — precios justos.",
      notice: "🤝 Todas las ventas se hacen en persona — llama para agendar una cita",
      sectionTitle: "Disponibles",
      contactHeading: "¿Te interesa algo?",
      contactSub: "Llámame o mándame un mensaje con lo que te interesa para agendar una cita y verlo en persona.",
      call: "Llamar",
      text: "Enviar mensaje",
      mileage: "Millas", transmission: "Transmisión", condition: "Estado", cleanTitle: "Título limpio",
      material: "Material", weight: "Peso", brand: "Marca", movement: "Movimiento",
      yes: "Sí", no: "No",
      auto: "Automático", manual: "Manual", quartz: "Cuarzo",
      excellent: "Excelente", good: "Bueno", fair: "Regular",
      available: "Disponible", sold: "Vendido",
      financingYes: "Opción de pagos", financingNo: "Sin opción de pagos",
      backLink: "← Volver al catálogo",
      toggleLabel: "ENGLISH",
      cat_all: "Todo", cat_cars: "Autos", cat_gold: "Oro", cat_watches: "Relojes", cat_other: "Otros"
    },
    en: {
      tagline: "Cars, gold jewelry, watches and more — fair prices.",
      notice: "🤝 All sales are made in person — call to set up a time",
      sectionTitle: "Available",
      contactHeading: "Interested in something?",
      contactSub: "Call or text me what you're interested in to set up a time to see it in person.",
      call: "Call",
      text: "Text",
      mileage: "Miles", transmission: "Transmission", condition: "Condition", cleanTitle: "Clean title",
      material: "Material", weight: "Weight", brand: "Brand", movement: "Movement",
      yes: "Yes", no: "No",
      auto: "Automatic", manual: "Manual", quartz: "Quartz",
      excellent: "Excellent", good: "Good", fair: "Fair",
      available: "Available", sold: "Sold",
      financingYes: "Payment plan available", financingNo: "No payment plan",
      backLink: "← Back to catalog",
      toggleLabel: "ESPAÑOL",
      cat_all: "All", cat_cars: "Cars", cat_gold: "Gold", cat_watches: "Watches", cat_other: "Other"
    }
  };

  const categories = ["all", "cars", "gold", "watches", "other"];

  // TUS ARTÍCULOS — edita esta lista para agregar, quitar o cambiar cosas.
  // "category" debe ser uno de: cars, gold, watches, other
  // "financing": true si ese artículo tiene opción de pagos a plazos, false si no.
  // "photos": lista de fotos del artículo (puede tener una o varias). Para usar tus
  //   propias fotos, súbelas a algún lugar en línea (ej. Imgur, Google Drive con enlace
  //   público) y pon aquí esos enlaces entre comillas. Si dejas photos: [] no aparece
  //   ninguna foto y se muestra el recuadro con el texto "Foto".
  // "description": tu texto personalizado sobre el artículo. Puedes escribir uno para
  //   cada idioma como {es:"...", en:"..."}, o dejarlo así: "" si no quieres poner nada.
  // En specs, usa {label:"clave", value: ...}:
  //   - value como texto/número se muestra tal cual (ej. una marca o un peso ya con unidad)
  //   - value como "auto", "manual", "quartz", "good", etc. se traduce solo
  //   - value como {es:"...", en:"..."} se traduce con tu propio texto en cada idioma
  const items = [
    {
      category: "cars", name: "2016 Honda Accord",
      price: 9500, status: "available", financing: true,
      photos: [
        "data:image/jpeg;base64,",
        "data:image/jpeg;base64,",
        "data:image/jpeg;base64,"
      ],
      description: {
        es: "Carro muy bien cuidado, siempre con mantenimiento al día. Aire acondicionado frío, llantas casi nuevas. Ideal para alguien que busca algo confiable para el trabajo diario.",
        en: "Very well maintained, always serviced on schedule. Cold A/C, nearly new tires. Great for someone looking for something reliable for daily driving."
      },
      specs: [
        { label: "mileage", value: 88000 },
        { label: "transmission", value: "auto" },
        { label: "condition", value: "good" },
        { label: "cleanTitle", value: true }
      ]
    },
    {
      category: "cars", name: "2012 Ford F-150",
      price: 12000, status: "available", financing: false,
      photos: [],
      description: "",
      specs: [
        { label: "mileage", value: 130000 },
        { label: "transmission", value: "auto" },
        { label: "condition", value: "fair" },
        { label: "cleanTitle", value: true }
      ]
    },
    {
      category: "cars", name: "2018 Nissan Sentra",
      price: 7800, status: "sold", financing: false,
      photos: [],
      description: "",
      specs: [
        { label: "mileage", value: 62000 },
        { label: "transmission", value: "auto" },
        { label: "condition", value: "excellent" },
        { label: "cleanTitle", value: false }
      ]
    },
    {
      category: "gold", name: "Anillo de oro 14k",
      price: 250, status: "available", financing: false,
      photos: [
        "data:image/jpeg;base64,",
        "data:image/jpeg;base64,"
      ],
      description: "",
      specs: [
        { label: "material", value: { es: "Oro amarillo 14k", en: "14k yellow gold" } },
        { label: "weight", value: "3.2 g" }
      ]
    },
    {
      category: "gold", name: "Cadena de oro",
      price: 600, status: "available", financing: false,
      photos: [],
      description: "",
      specs: [
        { label: "material", value: { es: "Oro amarillo 10k", en: "10k yellow gold" } },
        { label: "weight", value: "15 g" }
      ]
    },
    {
      category: "watches", name: "Reloj Invicta",
      price: 120, status: "sold", financing: false,
      photos: [],
      description: "",
      specs: [
        { label: "brand", value: "Invicta" },
        { label: "movement", value: "quartz" },
        { label: "condition", value: "good" }
      ]
    }
  ];

  let currentLang = (navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en";
  let activeCategory = "all";

  function specVal(v){
    if (v && typeof v === "object" && "es" in v) return v[currentLang];
    if (typeof v === "boolean") return v ? t[currentLang].yes : t[currentLang].no;
    if (typeof v === "string" && t[currentLang][v] !== undefined) return t[currentLang][v];
    if (typeof v === "number") return v.toLocaleString();
    return v;
  }

  function descVal(d){
    if (d && typeof d === "object" && "es" in d) return d[currentLang];
    if (typeof d === "string") return d;
    return "";
  }

  function renderNav(){
    const s = t[currentLang];
    const navEl = document.getElementById("category-nav");
    navEl.innerHTML = "";
    categories.forEach(cat => {
      const btn = document.createElement("button");
      btn.textContent = s["cat_" + cat];
      btn.className = cat === activeCategory ? "active" : "";
      btn.onclick = () => { activeCategory = cat; location.hash = ""; render(); };
      navEl.appendChild(btn);
    });
  }

  function itemId(item){
    return items.indexOf(item);
  }

  function openDetail(idx){
    location.hash = "item-" + idx;
  }

  function closeDetail(){
    location.hash = "";
  }

  let activePhotoIdx = 0;

  function setDetailPhoto(idx){
    activePhotoIdx = idx;
    const item = window.__currentDetailItem;
    if (!item) return;
    const mainImg = document.getElementById("detail-main-img");
    if (mainImg) mainImg.src = item.photos[idx];
    document.querySelectorAll(".thumb-row img").forEach((el, i) => {
      el.classList.toggle("active", i === idx);
    });
  }

  function renderDetailCard(item){
    const s = t[currentLang];
    window.__currentDetailItem = item;
    activePhotoIdx = 0;
    const specsHtml = item.specs.map(sp =>
      `<li><strong>${s[sp.label]}:</strong> ${specVal(sp.value)}</li>`
    ).join("");
    const financingClass = item.financing ? "yes" : "no";
    const financingLabel = item.financing ? s.financingYes : s.financingNo;
    const descText = descVal(item.description);
    const photos = item.photos || [];
    const imageInner = photos.length
      ? `<img id="detail-main-img" src="${photos[0]}" alt="${item.name}">`
      : `${currentLang === "es" ? "Foto" : "Photo"}`;
    const thumbsHtml = photos.length > 1
      ? `<div class="thumb-row">${photos.map((p, i) =>
          `<img src="${p}" class="${i === 0 ? "active" : ""}" onclick="setDetailPhoto(${i})" alt="">`
        ).join("")}</div>`
      : "";
    const detailCard = document.getElementById("detail-card");
    detailCard.dataset.status = item.status;
    detailCard.innerHTML = `
      <div class="detail-image">${imageInner}
        <span class="price-tag">$${item.price.toLocaleString()}</span>
      </div>
      ${thumbsHtml}
      <div class="detail-body">
        <span class="category-label">${s["cat_" + item.category]}</span>
        <h2 class="detail-name">${item.name}</h2>
        <div class="detail-badges">
          <span class="status ${item.status}">${s[item.status]}</span>
          <span class="financing-badge ${financingClass}">${financingLabel}</span>
        </div>
        <ul class="detail-specs">${specsHtml}</ul>
        ${descText ? `<p class="detail-description">${descText}</p>` : ""}
      </div>
    `;
  }

  function render(){
    const s = t[currentLang];
    document.documentElement.lang = currentLang;
    document.getElementById("tagline").textContent = s.tagline;
    document.getElementById("notice-text").textContent = s.notice;
    document.getElementById("section-title").textContent = s.sectionTitle;
    document.getElementById("contact-heading").textContent = s.contactHeading;
    document.getElementById("contact-sub").textContent = s.contactSub;
    document.getElementById("call-link").textContent = "📞 " + s.call;
    document.getElementById("text-link").textContent = "💬 " + s.text;
    document.getElementById("lang-toggle").textContent = s.toggleLabel;
    document.getElementById("back-link").textContent = s.backLink;

    renderNav();

    // ¿Estamos viendo el detalle de un artículo? (hash tipo #item-2)
    const hashMatch = location.hash.match(/^#item-(\d+)$/);
    const selected = hashMatch ? items[parseInt(hashMatch[1], 10)] : null;

    if (selected){
      document.getElementById("grid-view").style.display = "none";
      document.getElementById("detail-view").style.display = "block";
      renderDetailCard(selected);
      window.scrollTo(0, 0);
      return;
    }

    document.getElementById("grid-view").style.display = "block";
    document.getElementById("detail-view").style.display = "none";

    const grid = document.getElementById("item-grid");
    grid.innerHTML = "";
    const visible = items.filter(i => activeCategory === "all" || i.category === activeCategory);

    visible.forEach(item => {
      const card = document.createElement("article");
      card.className = "item-card";
      card.dataset.status = item.status;
      card.onclick = () => openDetail(itemId(item));
      const specsHtml = item.specs.map(sp =>
        `<li><strong>${s[sp.label]}:</strong> ${specVal(sp.value)}</li>`
      ).join("");
      const financingClass = item.financing ? "yes" : "no";
      const financingLabel = item.financing ? s.financingYes : s.financingNo;
      const cardImageInner = (item.photos && item.photos.length)
        ? `<img src="${item.photos[0]}" alt="${item.name}">`
        : (currentLang === "es" ? "Foto" : "Photo");
      card.innerHTML = `
        <div class="item-image">${cardImageInner}</div>
        <span class="price-tag">$${item.price.toLocaleString()}</span>
        <div class="financing-row">
          <span class="financing-badge ${financingClass}">${financingLabel}</span>
        </div>
        <div class="item-info">
          <span class="category-label">${s["cat_" + item.category]}</span>
          <h3>${item.name}</h3>
          <ul class="specs">${specsHtml}</ul>
          <span class="status ${item.status}">${s[item.status]}</span>
        </div>
      `;
      grid.appendChild(card);
    });
  }

  function toggleLang(){
    currentLang = currentLang === "es" ? "en" : "es";
    render();
  }

  window.addEventListener("hashchange", render);
  render();
</script>

</body>
</html>
